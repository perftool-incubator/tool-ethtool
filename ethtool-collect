#!/bin/bash

interfaces=$1; shift
interval=$1; shift

re='^[1-9][0-9]*$'
if [[ ! "$interval" =~ $re ]]; then
    echo "Interval must be a positive integer, exiting"
    exit 1
fi

if [ "$(pwd)" == "/" ]; then
    echo "Don't run this in /"
    exit 2
fi

mkdir -p ethtool-data

for iface in $(echo "$interfaces" | sed 's/,/ /g'); do
    if [ -d "/sys/class/net/$iface" ]; then
        echo "$iface is valid"
    else
        echo "$iface not found, skipping"
    fi
done

echo "Collecting ethtool -S for: $interfaces (interval: ${interval}s)"

while true; do
    timestamp="DATE:$(date +%s.%N)"
    for iface in $(echo "$interfaces" | sed 's/,/ /g'); do
        if [ ! -d "/sys/class/net/$iface" ]; then
            continue
        fi
        outfile="ethtool-data/${iface}.txt"
        echo "$timestamp" >> "$outfile"
        ethtool -S "$iface" 2>/dev/null | grep -E 'rx[0-9]+_packets:|tx[0-9]+_packets:' >> "$outfile"
    done
    sleep "$interval"
done
