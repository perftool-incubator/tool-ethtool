{
    "presets": {
        "defaults" : [
            { "arg": "interval", "vals": ["3"] }
        ]
    },
    "validations": {
        "positive_integer" : {
            "description" : "a whole number greater than 0",
            "args" : [ "interval" ],
            "vals": "^[1-9][0-9]*$"
        },
        "interface_list" : {
            "description" : "a comma-separated list of network interface names to monitor (e.g. 'eth0,eth1'); omit to auto-detect all 'up' interfaces except loopback",
            "args" : [ "interfaces" ],
            "vals": "^[A-Za-z0-9_.:@-]+(,[A-Za-z0-9_.:@-]+)*$"
        }
    }
}
