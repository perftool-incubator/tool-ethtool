{
    "rickshaw-tool": {
        "schema": {
            "version": "2020.03.18"
        }
    },
    "tool": "ethtool",
    "controller": {
        "post-script": "%tool-dir%/ethtool-post-process.py"
    },
    "collector": {
        "files-from-controller": [
            {
                "src": "%tool-dir%/ethtool-start",
                "dest": "/usr/bin/"
            },
            {
                "src": "%tool-dir%/ethtool-collect",
                "dest": "/usr/bin/"
            },
            {
                "src": "%tool-dir%/ethtool-stop",
                "dest": "/usr/bin/"
            }
        ],
        "blacklist": [
            {
                "endpoint": "remotehosts",
                "collector-types": [ "client", "server" ]
            },
            {
                "endpoint": "kube",
                "collector-types": [ "client", "server" ]
            }
        ],
        "whitelist": [
            {
                "endpoint": "osp",
                "collector-types": [ "compute" ]
            },
            {
                "endpoint": "remotehosts",
                "collector-types": [ "profiler" ]
            },
            {
                "endpoint": "kube",
                "collector-types": [ "profiler" ]
            }
        ],
        "start": "ethtool-start",
        "stop": "ethtool-stop"
    }
}
